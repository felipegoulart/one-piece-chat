{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "build": {
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*"
      ],
      "outputs": [],
      "dependsOn": [
        "^build"
      ]
    },
    "test": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/vitest.config.ts"
      ],
      "dependsOn": [
        "transit",
        "@repo/vitest-config#build"
      ],
      "outputs": [
        "coverage.json"
      ]
    },
    "transit": {
      "dependsOn": [
        "^transit"
      ]
    },
    "//#format-and-lint": {},
    "//#format-and-lint:fix": {
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "clean": {
      "cache": false
    }
  }
}